android_app {
    name: "QtiEsimSwitcher",

    srcs: [
        "src/**/*.aidl",
        "src/**/*.java",
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
        "SettingsLib",
    ],
}
