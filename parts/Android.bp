android_app {
    name: "XiaomiParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "org.lineageos.settings.resources",
    ],

    required: [
        "privapp-permissions-org.lineageos.settings",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-org.lineageos.settings",
    src: "privapp-permissions-org.lineageos.settings.xml",
    relative_install_path: "permissions",
    system_ext_specific: true,
}
