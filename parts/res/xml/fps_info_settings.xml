<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/fps_info_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="fps_info_show_overlay"
        android:title="@string/fps_info_show_overlay_title"
        android:persistent="false" />

    <PreferenceCategory
        android:key="fps_info_lines_category"
        android:title="@string/fps_info_lines_category">

        <SwitchPreferenceCompat
            android:key="fps_info_show_cpu_usage"
            android:title="@string/fps_info_show_cpu_usage_title"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="fps_info_show_gpu_busy"
            android:title="@string/fps_info_show_gpu_busy_title"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="fps_info_show_gpu_clock"
            android:title="@string/fps_info_show_gpu_clock_title"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="fps_info_show_battery_temp"
            android:title="@string/fps_info_show_battery_temp_title"
            android:defaultValue="false" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="fps_info_footer"
        android:title="@string/fps_info_footer"
        android:selectable="false" />

</PreferenceScreen>
