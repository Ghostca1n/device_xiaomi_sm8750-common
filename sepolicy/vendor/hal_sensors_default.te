# Touch-based hand/palm detection sub-HAL
allow hal_sensors_default vendor_sysfs_xiaomi_touch:dir r_dir_perms;
allow hal_sensors_default vendor_sysfs_xiaomi_touch:file rw_file_perms;

# The fused light sensor ignores the back sensor while a flash LED is lit
r_dir_file(hal_sensors_default, sysfs_leds)
